<?xml version="1.0" ?>
<!DOCTYPE config SYSTEM "http://www.matsim.org/files/dtd/config_v2.dtd">
<config>

	<module name="controler">
		<param name="outputDirectory" value="../../output/{{WORKER}}/matsim" />
		<param name="firstIteration" value="0" />
		<param name="lastIteration" value="10" />
		<param name="eventsFileFormat" value="xml" />
		<param name="mobsim" value="qsim" />
		
		<!-- NOT WRITE TO OUTPUT -->
		<param name="writeEventsInterval" value="0" />
		<param name="writePlansInterval" value="0" />
		<param name="writeTripsInterval" value="0" />
		<param name="writeSnapshotsInterval" value="0" />
		<param name="createGraphsInterval" value="0" />
		<param name="legDurationsInterval" value="0" />
		<param name="legHistogramInterval" value="0" />
		<param name="dumpDataAtEnd" value="false" />
		<param name="cleanItersAtEnd" value="delete" />
	</module>

	<module name="plans" >
		<param name="inputPlansFile" value="../plans_scale0.375true.xml" />
	</module>
	<module name="network" >
		<param name="inputNetworkFile" value="network.xml" />
	</module>

	<module name="qsim">
		<param name="startTime" value="00:00:00"/>
		<param name="endTime" value="24:00:00"/>
		<param name="flowCapacityFactor" value="0.25"/>
		<param name="storageCapacityFactor" value="0.25"/>
	</module>

	<module name="planCalcScore">
		<parameterset type="scoringParameters" >
			<param name="earlyDeparture" value="-12.0" />
			<param name="lateArrival" value="-24.0" />
			<param name="marginalUtilityOfMoney" value="1.0" />
			<param name="performing" value="6.0" />
			<param name="subpopulation" value="null" />
			
			<!-- Giảm penalty line switch để khuyến khích PT đa tuyến -->
			<param name="utilityOfLineSwitch" value="-0.3" />
			<param name="waiting" value="-0.0" />
			
			<!-- Giảm penalty waiting PT để tránh false negatives trong 10 iterations -->
			<param name="waitingPt" value="-0.2" />

			<parameterset type="activityParams" >
				<param name="activityType" value="home" />
				<param name="typicalDuration" value="08:00:00" />
			</parameterset>

			<parameterset type="activityParams" >
				<param name="activityType" value="work" />
				<param name="typicalDuration" value="08:00:00" />
				<param name="openingTime" value="07:00:00" />
				<param name="latestStartTime" value="11:00:00" />
				<param name="closingTime" value="20:00:00" />
			</parameterset>

			<parameterset type="activityParams" >
				<param name="activityType" value="kindergarten1" />
				<param name="typicalDuration" value="00:05:00" />
				<param name="openingTime" value="07:00:00" />
				<param name="closingTime" value="09:00:00" />
			</parameterset>

			<parameterset type="activityParams" >
				<param name="activityType" value="kindergarten2" />
				<param name="typicalDuration" value="00:05:00" />
				<param name="openingTime" value="13:00:00" />
				<param name="closingTime" value="18:00:00" />
			</parameterset>

			<parameterset type="activityParams" >
				<param name="activityType" value="shopping" />
				<param name="typicalDuration" value="01:00:00" />
				<param name="openingTime" value="10:00:00" />
				<param name="closingTime" value="21:00:00" />
			</parameterset>
			
			<!-- Car: Baseline không đổi để làm reference -->
			<parameterset type="modeParams" >
				<param name="constant" value="-3.5" />
				<param name="marginalUtilityOfDistance_util_m" value="0.0" />
				<param name="marginalUtilityOfTraveling_util_hr" value="-7.0" />
				<param name="mode" value="car" />
				<param name="monetaryDistanceRate" value="0.0" />
			</parameterset>
			
			<!-- PT: Tối ưu cho PBIL với gradient mạnh và resolution cao -->
			<parameterset type="modeParams" >
				<!-- Constant đủ để PT cạnh tranh, tạo base attractiveness -->
				<param name="constant" value="0.8" />
				<param name="marginalUtilityOfDistance_util_m" value="0.0" />
				<!-- Travel disutility -2.0: Sweet spot cho PBIL gradient (0.69) -->
				<!-- Tạo evolutionary pressure mạnh nhưng không quá strict -->
				<param name="marginalUtilityOfTraveling_util_hr" value="-2.0" />
				<param name="mode" value="pt" />
				<param name="monetaryDistanceRate" value="0.0" />
			</parameterset>
			
			<parameterset type="modeParams" >
				<param name="constant" value="0.0" />
				<param name="marginalUtilityOfDistance_util_m" value="0.0" />
				<param name="marginalUtilityOfTraveling_util_hr" value="-1.0" />
				<param name="mode" value="walk" />
				<param name="monetaryDistanceRate" value="0.0" />
			</parameterset>
			
			<parameterset type="modeParams" >
				<param name="constant" value="-2.0" />
				<param name="marginalUtilityOfDistance_util_m" value="0.0" />
				<param name="marginalUtilityOfTraveling_util_hr" value="-6.0" />
				<param name="mode" value="bike" />
				<param name="monetaryDistanceRate" value="0.0" />
			</parameterset>
		</parameterset>
	</module>

	<module name="strategy">
		<!-- Innovation đến iteration 9 (90%) -->
		<!-- Cho phép khám phá tối đa, iteration 10 là measurement ổn định -->
		<param name="fractionOfIterationsToDisableInnovation" value="0.9" />
		
		<!-- Memory size = 3: Nhanh chóng quên plans kém, thích ứng với mạng lưới mới -->
		<param name="maxAgentPlanMemorySize" value="3" />
		
		<!-- ChangeExpBeta 35%: Đủ để học từ kinh nghiệm và tạo stability -->
		<parameterset type="strategysettings" >
			<param name="strategyName" value="ChangeExpBeta" />
			<param name="weight" value="0.35" />
		</parameterset>
		
		<!-- ChangeTripMode 45%: Đảm bảo 99.66% agents thử PT, 4 lần trung bình -->
		<parameterset type="strategysettings" >
			<param name="strategyName" value="ChangeTripMode" />
			<param name="weight" value="0.45" />
		</parameterset>
		
		<!-- ReRoute 20%: Tối ưu access/egress paths cho PT routes mới -->
		<parameterset type="strategysettings" >
			<param name="strategyName" value="ReRoute" />
			<param name="weight" value="0.20" />
		</parameterset>
		
		<!-- TimeAllocationMutator: REMOVED (weight = 0) -->
		<!-- Lý do: Trong 10 iterations không đủ thời gian tối ưu timing -->
		<!-- Chỉ tạo nhiễu và false negatives cho PBIL fitness evaluation -->
	</module>
	
	<!-- Cấu hình ChangeTripMode để kiểm soát mode switching behavior -->
	<module name="changeTripMode">
		<param name="modes" value="car,pt,bike,walk" />
		<param name="ignoreCarAvailability" value="false" />
	</module>

	<module name="transit">
		<param name="transitScheduleFile" value="schedule.xml" />
		<param name="vehiclesFile" value="vehicles.xml" />
		<param name="transitModes" value="pt" />
		<param name="useTransit" value="true" />
	</module>
</config>